PROJECT_NAME=svoe-vino-recognition-service
POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=svoe-vino-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MINIO_IMAGE_TAG=latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_LICENSE_PATH=.\.machine-dependent\licenses
MINIO_IMAGE_BUCKET=images
MINIO_SECURE=false
MINIO_IMAGE_PREFIX=client
RABBITMQ_IMAGE_TAG=3.13-management
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=svie-vino-rmq-backend
RABBITMQ_DEFAULT_PASS=svoe-vino-rmq-rec
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_TASK_PUBLISH_QUEUE=recognition.tasks
RABBITMQ_TASK_RESULT_QUEUE=recognition.results
RABBITMQ_INFERENCE_PREFETCH_COUNT=1
RABBITMQ_INFERENCE_URL=amqp://svie-vino-rmq-backend:svoe-vino-rmq-rec@rabbitmq:5672/
QDRANT_IMAGE_TAG=latest
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_INTERNAL_PORT=6333
QDRANT_INTERNAL_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION_NAME=wines
INFERENCE_BUILD_CONTEXT=.\inference
INFERENCE_DOCKERFILE=.dockerfile
INFERENCE_MODEL_WEIGHTS_PATH=/app/models/ArcFace_v2.pth
INFERENCE_YOLO_WEIGHTS_PATH=/app/models/YOLO_best_100.pt
INFERENCE_EMBEDDING_SIZE=512
INFERENCE_IMAGE_SIZE=224
INFERENCE_DEVICE=cuda:0
BACKEND_PORT=8080
BACKEND_INTERNAL_PORT=8080
APP_NAME=svoe-vino-recognition-service-backend
APP_VERSION=0.1.0-TEST
FASTAPI_DEBUG=true
FASTAPI_TITLE=bakend
PARSER_BASE_URL=https://vino-svoe.ru
PARSER_TIMEOUT=10
PARSER_MAX_RETRIES=3
PARSER_RETRY_DELAY=1
LOGGING_LEVEL=INFO
LOGGING_LOGS_DIRECTORY=./logs/
LOGGING_FILE=
LOGGING_SERIALIZE=false
